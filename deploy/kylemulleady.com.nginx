# Generated by build.py. Install with deploy/install-server.sh.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name kylemulleady.com;

    root /var/www/kylemulleady.com;
    index index.html;

    access_log /var/log/kylemulleady.com/access.log;
    error_log  /var/log/kylemulleady.com/error.log;

    ssl_certificate     /etc/letsencrypt/live/kylemulleady.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kylemulleady.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    # Static HTML with no scripts of any kind, so the policy can be absolute.
    add_header Content-Security-Policy "default-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Posts moved from /blog/<id> to /blog/<slug>/ in the 2026 rebuild.
    location = /blog/1 { return 301 /blog/a-palatable-react-based-toolkit/; }
    location = /blog/2 { return 301 /blog/rcca-a-redux-architecture-blend/; }
    location = /blog/3 { return 301 /blog/the-underrated-flask-ecosystem/; }
    location = /blog/5 { return 301 /blog/async-await-in-javascript/; }
    location = /blog/14 { return 301 /blog/unit-testing/; }
    location = /blog/15 { return 301 /blog/dockerizing-things/; }

    # The two 2016 stubs were not republished.
    location = /blog/4  { return 301 /blog/; }
    location = /blog/13 { return 301 /blog/; }

    # /login, /contact and the whole /api surface belonged to the retired .NET app.
    location = /login   { return 301 /; }
    location = /contact { return 301 /; }
    location /api       { return 410; }

    # `expires` alone, deliberately. An add_header here would replace the block-level
    # add_header set above rather than adding to it, quietly dropping the CSP and
    # nosniff headers from every stylesheet and image.
    location /css    { expires 7d; }
    location /images { expires 30d; }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}

server {
    listen 80;
    listen [::]:80;
    server_name kylemulleady.com www.kylemulleady.com;
    return 301 https://kylemulleady.com$request_uri;
}

server {
    listen 443 ssl;
    server_name www.kylemulleady.com;
    ssl_certificate     /etc/letsencrypt/live/kylemulleady.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kylemulleady.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    return 301 https://kylemulleady.com$request_uri;
}
